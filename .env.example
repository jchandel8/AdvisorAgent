# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://advisor_app:CHANGE_ME@localhost:5432/wealth
# Optional: defaults to DATABASE_URL with the database name replaced by wealth_test
TEST_DATABASE_URL=
# Where Claude runs: anthropic (default: Anthropic API with the key below) or bedrock (Amazon Bedrock with your
# AWS login / the ECS task role; no key). AWS uses bedrock.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional. Defaults: claude-sonnet-5-5 (anthropic) or us.anthropic.claude-sonnet-5-5 (bedrock). Alternatives:
# claude-haiku-5-5 (cheapest; also matched the demo questions), claude-opus-5-5. On Bedrock, until the 5.5
# models are enabled for the account: us.anthropic.claude-sonnet-4-6.
ANTHROPIC_MODEL=
# Optional: the scope check's small model. Defaults: claude-haiku-5-5 / us.anthropic.claude-haiku-5-5.
# On Bedrock until 5.5 is enabled: us.anthropic.claude-haiku-4-5-20251001-v1:0
GUARD_MODEL=
# Optional (bedrock): region for Bedrock calls; falls back to AWS_REGION.
BEDROCK_REGION=us-west-1
# Optional: YYYY-MM-DD; mock data dates are relative to this (defaults to today)
DATA_ANCHOR_DATE=
# Answer cache: exact repeat questions are answered from the database with no model call.
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_HOURS=24
ANSWER_CACHE_MAX_ENTRIES=1000
# Sign-in: AUTH_MODE=demo (local user picker; refused on AWS) or cognito (Cognito login).
AUTH_MODE=demo
# For AUTH_MODE=cognito: values from `infra/tf.sh persistent output`.
COGNITO_REGION=us-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
# Shared password for the demo logins (wealth.ops.demo_logins). Never commit it.
DEMO_PASSWORD=
# Assistant guardrails: per-advisor request limits, and the scope check that blocks off-topic questions.
ASSISTANT_PER_MINUTE=10
ASSISTANT_PER_DAY=100
ASSISTANT_GUARD_ENABLED=true
# Uploaded documents: docker compose sets DOCUMENTS_BUCKET and S3_ENDPOINT_URL for its local S3 container.
# On AWS, Terraform sets DOCUMENTS_BUCKET and the task role reaches real S3 (no keys).
